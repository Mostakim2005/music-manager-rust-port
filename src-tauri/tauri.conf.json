{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Manager",
  "version": "2.0.0",
  "identifier": "com.musicmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Music Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self' stream: http://stream.localhost https: data: blob: 'unsafe-inline' 'unsafe-eval'; media-src 'self' stream: http://stream.localhost https: blob: data:; connect-src 'self' ipc: http://ipc.localhost stream: http://stream.localhost https: ws:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
